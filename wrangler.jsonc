{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "manutencaopiscina",
  "main": "src/index.js",
  "compatibility_date": "2026-06-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "piscina",
      "database_id": "1fd1a0e5-f365-48c5-b97c-3619c7821348"
    }
  ],
  // Mantém as variáveis criadas no painel (GOOGLE_CLIENT_ID, ALLOWED_EMAILS…) a cada deploy.
  "keep_vars": true,
  "observability": { "enabled": true }
}
